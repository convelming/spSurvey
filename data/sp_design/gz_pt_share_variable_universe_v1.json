        "bike_ebike.total_cost <= car_ride_hailing.total_cost",
        "bus.wait_time <= bus.total_time",
        "metro.access_time <= metro.total_time",
        "bus.fare >= 2",
        "bus.fare <= 3",
        "metro.fare >= 2",
        "metro.fare <= 5"
