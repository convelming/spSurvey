    "design_spec": {
      "asc_base_alternative": "bus",
      "sp_intro_text": "本场景用于研究广州公交客流减少的原因及敏感性：在给定一次约5km左右的城市出行情境下，比较公交与地铁、骑行/电动自行车、小汽车/网约车等替代方式。为适配街头调查和纸笔问卷，每个方式仅展示4个核心可感知变量。",
      "conditions": [
        "metro.total_time <= bus.total_time * 1.35",
        "bike_ebike.travel_time <= bus.total_time * 1.5",
        "car_ride_hailing.travel_time <= bus.total_time * 1.25",
        "car_ride_hailing.access_or_parking_time <= car_ride_hailing.travel_time * 1.2",
        "car_ride_hailing.total_cost >= bus.fare",
        "metro.fare >= bus.fare",
        "bike_ebike.total_cost <= car_ride_hailing.total_cost",
        "bus.wait_time <= bus.total_time",
        "metro.access_time <= metro.total_time",
        "bus.fare >= 2",
        "bus.fare <= 3",
        "metro.fare >= 2",
        "metro.fare <= 5"
      ],
